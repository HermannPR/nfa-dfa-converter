digraph DFA {
rankdir=LR;
node [shape=circle, fontsize=12];
edge [fontsize=10];
graph [dpi=450, size="12,3", ratio=fill];
ranksep=0.8;
nodesep=0.6;
splines=true;
overlap=false;
concentrate=true;
D1 [shape=doublecircle];
D3 [shape=doublecircle];
start [shape=point];
start -> D0;
D0 -> D1 [label="c"];
D0 -> D2 [label="a"];
D0 -> D3 [label="b"];
D1 -> D4 [label="c"];
D1 -> D4 [label="a"];
D1 -> D4 [label="b"];
D2 -> D2 [label="a"];
D2 -> D3 [label="b"];
D2 -> D4 [label="c"];
D3 -> D4 [label="c"];
D3 -> D4 [label="a"];
D3 -> D4 [label="b"];
D4 -> D4 [label="c"];
D4 -> D4 [label="a"];
D4 -> D4 [label="b"];
}